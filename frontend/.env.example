# ==============================================================================
# GH Wealth Management AI Coach - Frontend Environment Configuration
# ==============================================================================

# Backend Service URL (Cloud Run service URL or internal VPC URL)
# Next.js server will proxy requests to /api/* to this URL
BACKEND_URL=https://wm-coach-backend-YOUR_HASH-uc.a.run.app

# Optional: Direct public API endpoint for client-side fetching (defaults to /api)
# NEXT_PUBLIC_API_URL=https://wm-coach-backend-YOUR_HASH-uc.a.run.app/api
NEXT_PUBLIC_API_URL=/api

PORT=8080
NODE_ENV=production
