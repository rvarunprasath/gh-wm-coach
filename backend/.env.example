# ==============================================================================
# GH Wealth Management AI Coach - Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8080
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# Placeholder: Replace with your actual key or mount from Google Secret Manager
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Optional: If running inside GCP using Vertex AI instead of AI Studio API Key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GCP_PROJECT=YOUR_GCP_PROJECT_ID
# GCP_REGION=us-central1

# ------------------------------------------------------------------------------
# Database Configuration (AlloyDB for PostgreSQL / PostgreSQL)
# ------------------------------------------------------------------------------
# In Cloud Run with Direct VPC Egress, point DB_HOST to the AlloyDB Primary Instance Private IP.
# If left empty, the application automatically falls back to local SQLite.
DB_HOST=10.10.0.3
DB_PORT=5432
DB_NAME=financial_coach
DB_USER=postgres
DB_PASSWORD=YOUR_ALLOYDB_PASSWORD_HERE

# Alternatively, specify the full connection string:
# DATABASE_URL=postgresql://postgres:YOUR_ALLOYDB_PASSWORD_HERE@10.10.0.3:5432/financial_coach
